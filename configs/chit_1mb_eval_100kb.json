{
  "seed": 42,
  "device": "cpu",
  "model": {
    "vocab_size": 256,
    "block_size": 512,
    "n_layer": 4,
    "n_head": 4,
    "n_embd": 128,
    "dropout": 0.05
  },
  "training": {
    "batch_size": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.1,
    "max_steps": 1500,
    "eval_interval": 250,
    "eval_steps": 8,
    "checkpoint_interval": 1000,
    "grad_clip": 1.0,
    "warmup_steps": 100,
    "lr_schedule": "cosine",
    "min_lr_ratio": 0.1
  },
  "data": {
    "train_file": "data/train_1mb.txt",
    "eval_file": "data/eval_100kb.txt"
  }
}
