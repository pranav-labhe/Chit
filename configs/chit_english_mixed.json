{
  "model": {
    "vocab_size": 256,
    "block_size": 512,
    "n_layer": 4,
    "n_head": 4,
    "n_embd": 128,
    "dropout": 0.0,
    "position_encoding": "absolute"
  },
  "training": {
    "batch_size": 16,
    "max_steps": 1500,
    "learning_rate": 1e-4,
    "weight_decay": 0.01,
    "warmup_steps": 100
  },
  "data": {
    "sources": [
      {
        "path": "data/english_foundation/structural.txt",
        "weight": 0.30
      },
      {
        "path": "data/english_foundation/lexical_prose.txt",
        "weight": 0.30
      },
      {
        "path": "data/english_foundation/conversation.txt",
        "weight": 0.30
      },
      {
        "path": "data/english_foundation/project_facts.txt",
        "weight": 0.10
      }
    ],
    "eval_file": "data/english_foundation/eval_suite.json"
  },
  "device": "cpu"
}
