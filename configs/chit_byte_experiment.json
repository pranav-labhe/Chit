{
  "seed": 42,
  "device": "cpu",
  "model": {
    "vocab_size": 256,
    "block_size": 64,
    "n_layer": 2,
    "n_head": 2,
    "n_embd": 64,
    "dropout": 0.0,
    "position_encoding": "absolute"
  },
  "training": {
    "batch_size": 8,
    "learning_rate": 0.0005,
    "weight_decay": 0.1,
    "max_steps": 300,
    "eval_interval": 50,
    "eval_steps": 10,
    "checkpoint_interval": 100,
    "grad_clip": 1.0
  },
  "data": {
    "train_file": "data/train.txt",
    "eval_file": "data/eval.txt"
  },
  "tokenizer": {
    "name": "byte-utf8"
  }
}
